{
  "about": "Exam for the Intent layer (the AI). Run it with:  python -m ibn.intent.evaluate  (see ibn/intent/evaluate.py). Phase 1 = simple, phase 2 = several steps/devices, phase 3 = scenarios (describe the goal, describe a device, missing information). 'rejected' cases are negative tests: the system must refuse them.",

  "topology": {
    "devices": [
      {"name": "R1", "ip": "10.0.0.1", "vendor": "cisco_ios", "state": "up",
       "interfaces": ["Loopback0 10.0.0.1", "Ethernet0/0 10.1.2.1", "Ethernet0/2 10.0.1.1"]},
      {"name": "R2", "ip": "10.0.0.2", "vendor": "cisco_ios", "state": "up",
       "interfaces": ["Loopback0 10.0.0.2", "Ethernet0/0 10.1.2.2", "Ethernet0/1 10.2.3.2"]},
      {"name": "R3", "ip": "10.0.0.3", "vendor": "cisco_ios", "state": "up",
       "interfaces": ["Loopback0 10.0.0.3", "Ethernet0/1 10.2.3.3", "Ethernet0/2 10.0.3.3"]},
      {"name": "SW1", "ip": "10.0.1.11", "vendor": "cisco_ios", "state": "up",
       "interfaces": ["Vlan1 10.0.1.11"]},
      {"name": "SW3", "ip": "10.0.3.13", "vendor": "cisco_ios", "state": "up",
       "interfaces": ["Vlan1 10.0.3.13"]}
    ],
    "links": [["SW1", "R1"], ["R1", "R2"], ["R2", "R3"], ["R3", "SW3"]]
  },

  "cases": [
    {"phase": 1, "request": "Create VLAN 10 named Sales on SW1",
     "expect": {"devices": ["SW1"], "commands": ["vlan 10", "name Sales"], "verify": true}},
    {"phase": 1, "request": "Add loopback 5 with IP 5.5.5.5/32 on R1",
     "expect": {"devices": ["R1"], "commands": ["interface Loopback5", "ip address 5.5.5.5 255.255.255.255"]}},
    {"phase": 1, "request": "Ping R3 from R1",
     "expect": {"devices": ["R1"], "type": "check", "commands": ["ping"]}},
    {"phase": 1, "request": "Show the interfaces of R2",
     "expect": {"devices": ["R2"], "type": "check", "commands": ["show"]}},
    {"phase": 1, "request": "Set the description 'Uplink to R2' on Ethernet0/0 of R1",
     "expect": {"devices": ["R1"], "commands": ["interface Ethernet0/0", "description Uplink to R2"]}},
    {"phase": 1, "request": "Shut down Ethernet0/2 on R3",
     "expect": {"devices": ["R3"], "commands": ["interface Ethernet0/2", "shutdown"]}},
    {"phase": 1, "request": "Restart R1",
     "expect": {"rejected": true}},
    {"phase": 1, "request": "Create VLAN 10 on SW9",
     "expect": {"rejected": true}},

    {"phase": 2, "request": "Create VLAN 20 named HR on SW1 and SW3",
     "expect": {"devices": ["SW1", "SW3"], "commands": ["vlan 20", "name HR"]}},
    {"phase": 2, "request": "Add a static route on R1 to 192.168.50.0/24 via 10.1.2.2",
     "expect": {"devices": ["R1"], "commands": ["ip route 192.168.50.0 255.255.255.0 10.1.2.2"], "verify": true}},
    {"phase": 2, "request": "Create VLAN 30 on SW3, then ping R2 from R3",
     "expect": {"devices": ["SW3", "R3"], "commands": ["vlan 30", "ping"]}},
    {"phase": 2, "request": "Block the network 10.0.1.0/24 from reaching R3",
     "expect": {"commands": ["deny ip 10.0.1.0 0.0.0.255", "access-group"]}},
    {"phase": 2, "request": "Enable OSPF area 0 on R2 for its connected networks",
     "expect": {"devices": ["R2"], "commands": ["router ospf", "network 10.1.2.0 0.0.0.255 area 0", "network 10.2.3.0 0.0.0.255 area 0"]}},
    {"phase": 2, "request": "Delete the user admin on R1 and R2",
     "expect": {"rejected": true}},

    {"phase": 3, "request": "Create VLAN 40 on the switch connected to R3",
     "expect": {"devices": ["SW3"], "commands": ["vlan 40"]}},
    {"phase": 3, "request": "Add loopback 9 with IP 9.9.9.9/32 on the router between R1 and R3",
     "expect": {"devices": ["R2"], "commands": ["interface Loopback9", "ip address 9.9.9.9 255.255.255.255"]}},
    {"phase": 3, "request": "Make R1 reach the network 172.16.5.0/24 that is behind R2",
     "expect": {"devices": ["R1"], "commands": ["ip route 172.16.5.0 255.255.255.0 10.1.2.2"], "verify": true}},
    {"phase": 3, "request": "configure static routing",
     "expect": {"question": true}},
    {"phase": 3, "request": "create a vlan on SW1",
     "expect": {"question": true}},
    {"phase": 3, "request": "Erase the configuration of the router connected to SW3",
     "expect": {"rejected": true}}
  ]
}
