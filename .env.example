# Copy this file to ".env" and fill it in.  (.env is never uploaded to GitHub)

# ---------- Intent layer (AI) ----------
LLM_PROVIDER=claude                 # claude (cloud, needs key) or ollama (local, free)
ANTHROPIC_API_KEY=sk-ant-...        # from https://console.anthropic.com
CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_KEEP_ALIVE=15m             # how long the model stays loaded after the last request

# RAG: the closest solved examples from ibn/vendors/<vendor>/examples.json go into the AI's prompt
RAG_ENABLED=true                    # false = no RAG (to compare)
RAG_SOURCES=examples,docs           # examples.json and docs/ of each vendor folder
RAG_SEARCH=embedding                # embedding (needs: ollama pull bge-m3) or keyword (no model)
RAG_EMBED_MODEL=bge-m3
RAG_TOP_K=3                         # how many pieces of each source go into the prompt

# ---------- Knowledge base ----------
KB_FILE=data/knowledge.json         # devices, links and history

# ---------- Devices ----------
DEVICE_USERNAME=admin
DEVICE_PASSWORD=admin
# Cisco "enable" password (leave empty if you do not use one)
DEVICE_SECRET=
DRY_RUN=false                       # true = show what would happen, send nothing
PLAN_LOG=data/plans.csv             # every plan is saved here (opens in Excel); empty = off
