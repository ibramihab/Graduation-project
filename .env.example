# Copy this file to ".env" and fill it in.  (.env is never uploaded to GitHub)

# ---------- Intent layer (AI) ----------
LLM_PROVIDER=claude                 # claude (cloud, needs key) or ollama (local, free)
ANTHROPIC_API_KEY=sk-ant-...        # from https://console.anthropic.com
CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---------- Knowledge base ----------
KB_BACKEND=file                     # file (no install) or neo4j (graph database)
KB_FILE=data/knowledge.json
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ---------- Devices ----------
DEVICE_USERNAME=admin
DEVICE_PASSWORD=admin
# Cisco "enable" password (leave empty if you do not use one)
DEVICE_SECRET=
DRY_RUN=false                       # true = show what would happen, send nothing
